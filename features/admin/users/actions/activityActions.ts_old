"use server";

import { getSupabaseAdmin } from "@/lib/supabase";
import { logger } from "@/lib/logger";

const DEFAULT_LESSON_COMPLETION_MINUTES = 30;

function resolveLessonCompletionThreshold(): number {
  const raw = Number(
    process.env.LESSON_COMPLETION_MINUTES ?? DEFAULT_LESSON_COMPLETION_MINUTES,
  );
  return Number.isFinite(raw) && raw > 0
    ? raw
    : DEFAULT_LESSON_COMPLETION_MINUTES;
}

function shouldMarkLessonCompleted(
  alreadyCompleted: boolean | null | undefined,
  minutesWatched: number,
  threshold: number,
): boolean {
  return Boolean(alreadyCompleted) || minutesWatched >= threshold;
}

/**
 * Registra immediatamente l'accesso/cambio di una lezione aggiornando last_accessed_at.
 */
export async function touchLessonAccess(
  userId: string,
  courseId: string,
  lessonId: string,
) {
  if (!userId || !courseId || !lessonId) {
    return { success: false, error: "Parametri mancanti" };
  }

  const supabase = getSupabaseAdmin();
  const now = new Date().toISOString();

  try {
    const { error } = await supabase
      .from("profile_lessons_progress")
      .upsert(
        {
          profile_id: userId,
          lesson_id: lessonId,
          course_id: courseId,
          last_accessed_at: now,
          updated_at: now,
        },
        {
          onConflict: "profile_id,lesson_id",
          ignoreDuplicates: false,
        },
      );

    if (error) {
      logger.error("touchLessonAccess: errore upsert", { error: error.message });
      return { success: false, error: error.message };
    }

    logger.info("touchLessonAccess: accesso lezione registrato con successo", {
      userId,
      courseId,
      lessonId,
    });

    return { success: true };
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : "Internal Server Error";
    logger.error("touchLessonAccess: eccezione non gestita", { error: message });
    return { success: false, error: message };
  }
}

/**
 * Incrementa il tempo di studio dello studente e aggiorna lo stato di avanzamento della lezione corrente.
 */
export async function incrementStudentMinutes(
  userId: string,
  courseId?: string,
  lessonId?: string,
  minutesToAdd: number = 1,
) {
  logger.warn("SERVER ACTION incrementStudentMinutes", {
    userId,
    courseId,
    lessonId,
    minutesToAdd,
  });

  if (!userId) {
    logger.debug("incrementStudentMinutes: Missing User ID");
    return { success: false, error: "Missing User ID" };
  }

  if (minutesToAdd <= 0) {
    return { success: true, message: "Nessun minuto da aggiungere" };
  }

  const supabase = getSupabaseAdmin();
  const now = new Date().toISOString();
  const completionThreshold = resolveLessonCompletionThreshold();

  try {
    logger.debug("incrementStudentMinutes: heartbeat received", {
      userId,
      courseId,
      lessonId,
      minutesToAdd,
      completionThreshold,
    });

    // 1) Incremento minuti totali sul profilo dell'utente
    const { error: profileErr } = await supabase.rpc(
      "increment_profile_minutes",
      {
        user_id: userId,
        minutes_to_add: minutesToAdd,
      },
    );

    if (profileErr) {
      logger.debug(
        "incrementStudentMinutes: RPC increment_profile_minutes failed, using fallback",
        {
          userId,
          error: profileErr.message,
        },
      );

      const { data: profileRow, error: profileReadErr } = await supabase
        .from("profiles")
        .select("total_minutes_active")
        .eq("id", userId)
        .maybeSingle();

      if (profileReadErr) {
        logger.error("incrementStudentMinutes: fallback read profile error", {
          userId,
          error: profileReadErr.message,
        });
      } else if (profileRow) {
        const { error: profileUpdateErr } = await supabase
          .from("profiles")
          .update({
            total_minutes_active: (profileRow.total_minutes_active ?? 0) + minutesToAdd,
            updated_at: now,
          })
          .eq("id", userId);

        if (profileUpdateErr) {
          logger.error(
            "incrementStudentMinutes: fallback update profile error",
            {
              userId,
              error: profileUpdateErr.message,
            },
          );
        }
      }
    }

    // 2) Aggiornamento progresso lezione
    if (courseId && lessonId) {
      const { data: existingProgress, error: progressReadErr } = await supabase
        .from("profile_lessons_progress")
        .select("minutes_watched, is_completed")
        .eq("profile_id", userId)
        .eq("lesson_id", lessonId)
        .maybeSingle();

      if (progressReadErr) {
        logger.debug("incrementStudentMinutes: progress read warning", {
          userId,
          courseId,
          lessonId,
          error: progressReadErr.message,
        });
      }

      const currentMinutes = existingProgress?.minutes_watched ?? 0;
      const newMinutes = currentMinutes + minutesToAdd;
      const shouldComplete = shouldMarkLessonCompleted(
        existingProgress?.is_completed,
        newMinutes,
        completionThreshold,
      );

      logger.debug("incrementStudentMinutes: lesson progress computed", {
        userId,
        courseId,
        lessonId,
        currentMinutes,
        newMinutes,
        shouldComplete,
      });

      const { error: progressErr } = await supabase
        .from("profile_lessons_progress")
        .upsert(
          {
            profile_id: userId,
            lesson_id: lessonId,
            course_id: courseId,
            minutes_watched: newMinutes,
            is_completed: shouldComplete,
            last_accessed_at: now,
            updated_at: now,
          },
          {
            onConflict: "profile_id,lesson_id",
          },
        );

      if (progressErr) {
        logger.error("incrementStudentMinutes: progress upsert error", {
          userId,
          courseId,
          lessonId,
          error: progressErr.message,
        });
        throw progressErr;
      }
    }

    logger.info("incrementStudentMinutes: heartbeat stored successfully", {
      userId,
      courseId,
      lessonId,
      minutesToAdd,
    });

    return { success: true, message: "Heartbeat memorizzato con successo" };
  } catch (error: unknown) {
    logger.error("incrementStudentMinutes: unexpected exception", {
      userId,
      courseId,
      lessonId,
      error: String(error),
    });

    const message =
      error instanceof Error ? error.message : "Internal Server Error";
    return { success: false, error: message };
  }
}