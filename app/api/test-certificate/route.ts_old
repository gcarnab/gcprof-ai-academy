import { NextResponse } from "next/server";
import { SupabaseCertificateRepository } from "@/features/certificates/repositories/SupabaseCertificateRepository";
import { generatePdfFromHtml } from "@/lib/pdfGenerator";
import { getSupabaseAdmin } from "@/lib/supabase";
import { EmailService } from "@/features/admin/mail/services/EmailService";
import fs from "fs";
import path from "path";

/**
 * Helper che converte qualsiasi immagine (file locale in public/, URL remoto HTTPS o Data URL)
 * in una stringa Base64 pronta per Puppeteer (funziona sia su localhost che su Vercel).
 */
async function resolveImageAsBase64(imagePath: string | null | undefined): Promise<string> {
  if (!imagePath) return "";

  try {
    // 1. Se è già un Data URL Base64
    if (imagePath.startsWith("data:")) {
      return imagePath;
    }

    // 2. Se è un URL remoto HTTPS/HTTP (es. Supabase Storage o CDN)
    if (imagePath.startsWith("http://") || imagePath.startsWith("https://")) {
      const response = await fetch(imagePath);
      if (response.ok) {
        const arrayBuffer = await response.arrayBuffer();
        const buffer = Buffer.from(arrayBuffer);
        const contentType = response.headers.get("content-type") || "image/png";
        return `data:${contentType};base64,${buffer.toString("base64")}`;
      }
    }

    // 3. Se è un percorso relativo locale nella cartella public/
    const cleanPath = imagePath.startsWith("/") ? imagePath.slice(1) : imagePath;
    const fullPath = path.join(process.cwd(), "public", cleanPath);

    if (fs.existsSync(fullPath)) {
      const fileBuffer = fs.readFileSync(fullPath);
      const ext = path.extname(fullPath).replace(".", "").toLowerCase() || "png";
      const mimeType = ext === "svg" ? "image/svg+xml" : `image/${ext}`;
      return `data:${mimeType};base64,${fileBuffer.toString("base64")}`;
    } else {
      console.warn(`⚠️ [TestRoute] File logo non trovato sul filesystem: ${fullPath}`);
    }
  } catch (err) {
    console.error("❌ [TestRoute] Errore nella conversione del logo in Base64:", err);
  }

  return imagePath;
}

export async function GET() {
  const logs: string[] = [];
  const log = (msg: string) => {
    console.log(msg);
    logs.push(msg);
  };

  try {
    const repo = new SupabaseCertificateRepository();
    const TEST_USER_ID = "ccc07580-f37b-42e3-93e8-9680099fbebe";

    // 1. Verifica lettura Settings
    log("1. Lettura certificate_settings dal DB...");
    const settings = await repo.getSettings();
    if (!settings) {
      throw new Error(
        "❌ Impostazioni non trovate nel DB (getSettings() ha restituito null). Controlla se la tabella certificate_settings contiene un record."
      );
    }
    log(`   -> OK: Template predefinito configurato = ${settings.defaultTemplateId}`);

    // 2. Verifica lettura Template
    log("2. Lettura certificate_templates...");
    if (!settings.defaultTemplateId) {
      throw new Error("❌ defaultTemplateId è null nelle impostazioni del certificato.");
    }
    const template = await repo.getTemplate(settings.defaultTemplateId);
    if (!template) {
      throw new Error(
        `❌ Template con ID ${settings.defaultTemplateId} non trovato nella tabella certificate_templates.`
      );
    }
    log(`   -> OK: Template trovato = "${template.name}"`);

    // 3. Recupero dati utente da Supabase Auth
    log("3. Recupero email e nome utente da Supabase Auth...");
    const supabaseAdmin = getSupabaseAdmin();
    let email = "";
    let name = "Studente Test";

    const { data: userData } = await supabaseAdmin.auth.admin.getUserById(TEST_USER_ID);

    if (userData?.user?.email) {
      email = userData.user.email;
      name =
        userData.user.user_metadata?.full_name ||
        userData.user.user_metadata?.name ||
        email;
      log(`   -> OK: Utente trovato in Supabase Auth = ${name} (${email})`);
    } else {
      log("   ⚠️ Utente non trovato con l'ID specificato. Uso email e nome di fallback per il test...");
      email = "giuscar74@gmail.com";
      name = "Giuseppe Carnabuci";
      log(`   -> Fallback impostato = ${name} (${email})`);
    }

    // 4. Test Generazione PDF con Puppeteer
    log("4. Compilazione HTML e Generazione PDF con Puppeteer...");
    const dummyToken = "TEST-VERIFICATION-TOKEN-12345";
    const verificationUrl = `${process.env.NEXT_PUBLIC_APP_URL || "http://localhost:3000"}/test-certificate/${dummyToken}`;

    // Recupero il percorso raw del logo (Template -> Settings -> Fallback locale)
    const rawLogoPath =
      template.logoUrl ||
      settings.logoUrl ||
      "/gcprof-ai-academy_logo_01.png";

    log(`   -> Logo sorgente individuato: "${rawLogoPath}"`);

    // Conversione in Base64 Data URL
    const logoBase64 = await resolveImageAsBase64(rawLogoPath);

    // Compilazione dei placeholder (incluso {{logoUrl}})
    const compiledHtml = template.htmlTemplate
      .replace(/\{\{logoUrl\}\}/g, logoBase64)
      .replace(/\{\{studentName\}\}/g, name)
      .replace(/\{\{courseTitle\}\}/g, "Corso di Prova Certificati")
      .replace(/\{\{score\}\}/g, "95")
      .replace(/\{\{date\}\}/g, new Date().toLocaleDateString("it-IT"))
      .replace(/\{\{certificateNumber\}\}/g, "CERT-TEST-001")
      .replace(/\{\{verificationUrl\}\}/g, verificationUrl);

    // Documento HTML completo e strutturato con codifica UTF-8
    const fullHtml = `
      <!DOCTYPE html>
      <html lang="it">
        <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <style>
            ${template.cssTemplate || ""}
          </style>
        </head>
        <body>
          ${compiledHtml}
        </body>
      </html>
    `;

    const pdfBuffer = await generatePdfFromHtml(fullHtml);
    log(`   -> OK: PDF generato con successo (${pdfBuffer.length} bytes)`);

    // 5. Test Upload Supabase Storage
    log("5. Upload PDF su Supabase Storage (bucket 'certificates')...");
    const fileName = `test/${Date.now()}.pdf`;
    const { error: uploadError } = await supabaseAdmin.storage
      .from("certificates")
      .upload(fileName, pdfBuffer, {
        contentType: "application/pdf",
        upsert: true,
      });

    if (uploadError) {
      throw new Error(
        `❌ Errore durante l'upload su Storage: ${uploadError.message}. Verifica che il bucket 'certificates' esista e sia pubblico.`
      );
    }

    const { data: publicUrlData } = supabaseAdmin.storage
      .from("certificates")
      .getPublicUrl(fileName);

    log(`   -> OK: PDF caricato con successo. Public URL: ${publicUrlData.publicUrl}`);

    // 6. Test Invio Email
    log("6. Invio Email con allegato PDF...");
    const emailService = new EmailService();
    await emailService.sendCertificateEmail(
      email,
      name,
      "Corso di Prova Certificati",
      pdfBuffer,
      publicUrlData.publicUrl
    );
    log("   -> OK: Email inviata con successo!");

    return NextResponse.json({
      success: true,
      message: "🎉 Test diagnostico dell'intero flusso completato con successo!",
      publicPdfUrl: publicUrlData.publicUrl,
      logs,
    });
  } catch (error: any) {
    log(`❌ ERRORE CRITICO: ${error?.message || error}`);
    return NextResponse.json(
      {
        success: false,
        error: error?.message || "Errore sconosciuto durante il test.",
        logs,
      },
      { status: 500 }
    );
  }
}